<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <XuiCopyNativeRuntime>false</XuiCopyNativeRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Designer\VisualDocument.cs" Link="VisualDocument.cs" />
    <Compile Include="..\Designer\DesignerLiteralCodec.cs" Link="DesignerLiteralCodec.cs" />
    <Compile Include="..\Designer\PreviewCompiler.cs" Link="PreviewCompiler.cs" />
    <EmbeddedResource Include="..\GeneratorTests\Fakes.cs" LogicalName="Designer.SourceTests.Fakes.cs" />
    <EmbeddedResource Include="..\Xui\ControlStyleCatalog.g.cs" LogicalName="Designer.SourceTests.ControlStyleCatalog.cs" />
    <ProjectReference Include="..\Xui.Generator\Xui.Generator.csproj" />
    <ProjectReference Include="..\Xui\Xui.csproj" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll" Private="true" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(XuiRuntimeIdentifier)</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>..\..\..\demo\xui.manifest</ApplicationManifest>
  </PropertyGroup>
  <Import Project="..\Xui.Native.targets" />
  <ItemGroup>
    <ProjectReference Include="..\Xui\Xui.csproj" />
    <ProjectReference Include="..\Xui.Generator\Xui.Generator.csproj" />
    <Analyzer Include="..\Xui.Generator\bin\$(Configuration)\net10.0\Xui.Generator.dll" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll" />
    <Compile Include="..\Designer\VisualDocument.cs" Link="VisualDocument.cs" />
    <Compile Include="..\Designer\DesignerWorkspace.cs" Link="DesignerWorkspace.cs" />
    <Compile Include="..\Designer\DesignerHierarchy.cs" Link="DesignerHierarchy.cs" />
    <Compile Include="..\Designer\DesignerInspector.cs" Link="DesignerInspector.cs" />
    <Compile Include="..\Designer\DesignerLiteralCodec.cs" Link="DesignerLiteralCodec.cs" />
    <AdditionalFiles Include="..\Designer\DesignerHierarchyLayout.xui" />
    <AdditionalFiles Include="..\Designer\DesignerInspectorLayout.xui" />
  </ItemGroup>
</Project>

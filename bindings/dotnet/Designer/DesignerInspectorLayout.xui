namespace Xui.Designer;

component DesignerInspectorLayout {
    param global::Xui.Element Arguments;
    param global::Xui.Element ValueEditor;
    param global::Xui.Element Palette;
    state bool DimensionsOpen = false;
    state bool DimensionArgument = false;
    state bool BooleanOpen = false;
    state bool BooleanArgument = false;
    state bool InsetsOpen = false;
    state bool InsetsArgument = false;

    view {
        ScrollView("Properties and control palette") {
            VStack(padding: 10, spacing: 8) {
                Text("Properties", fontSize: 20, fontWeight: 600);
                Text("Select a control", ref: Selected, id: "designer-selected-node", wrapping: true);
                Text("Argument");
                Content(Arguments, preferredSize: (240, 36));
                Text("Literal source value (include quotes for text)", ref: ValueLabel, wrapping: true);
                Toggle("Edit as text", ref: TextMode, id: "designer-property-text-mode", enabled: false,
                    help: "Edit a string literal without quotes or escape sequences");
                Toggle("Edit dimensions", ref: DimensionMode, id: "designer-property-dimension-mode", enabled: false,
                    preferredSize: (240, DimensionArgument ? 32 : 0), visible: DimensionArgument,
                    help: "Edit a literal size as separate width and height fields");
                Toggle("Edit boolean", ref: BooleanMode, id: "designer-property-boolean-mode", enabled: false,
                    preferredSize: (240, BooleanArgument ? 32 : 0), visible: BooleanArgument,
                    help: "Edit a true or false literal with a native toggle");
                Toggle("Edit insets", ref: InsetsMode, id: "designer-property-insets-mode", enabled: false,
                    preferredSize: (240, InsetsArgument ? 32 : 0), visible: InsetsArgument,
                    help: "Edit padding or border thickness as left, top, right, and bottom values");
                Grid("Property value editor", preferredSize: (240, DimensionsOpen ? 60 : BooleanOpen ? 36 : InsetsOpen ? 126 : 80),
                    rows: [new(global::Xui.TrackSizing.Fixed, DimensionsOpen || BooleanOpen || InsetsOpen ? 0 : 80),
                        new(global::Xui.TrackSizing.Fixed, DimensionsOpen ? 60 : 0),
                        new(global::Xui.TrackSizing.Fixed, BooleanOpen ? 36 : 0),
                        new(global::Xui.TrackSizing.Fixed, InsetsOpen ? 126 : 0)]) {
                    Content(ValueEditor);
                    HStack(spacing: 6, row: 1) {
                        TextInput("Width", ref: DimensionWidth, id: "designer-property-width", visible: DimensionsOpen,
                            preferredSize: (106, 60), flex: 1);
                        TextInput("Height", ref: DimensionHeight, id: "designer-property-height", visible: DimensionsOpen,
                            preferredSize: (106, 60), flex: 1);
                    }
                    Toggle("Value: false", ref: BooleanValue, id: "designer-property-boolean-value", row: 2,
                        visible: BooleanOpen, help: "Choose true or false. Apply property commits the draft.");
                    VStack(spacing: 6, row: 3) {
                        HStack(spacing: 6) {
                            TextInput("Left", ref: InsetLeft, id: "designer-property-inset-left", visible: InsetsOpen,
                                preferredSize: (106, 60), flex: 1);
                            TextInput("Top", ref: InsetTop, id: "designer-property-inset-top", visible: InsetsOpen,
                                preferredSize: (106, 60), flex: 1);
                        }
                        HStack(spacing: 6) {
                            TextInput("Right", ref: InsetRight, id: "designer-property-inset-right", visible: InsetsOpen,
                                preferredSize: (106, 60), flex: 1);
                            TextInput("Bottom", ref: InsetBottom, id: "designer-property-inset-bottom", visible: InsetsOpen,
                                preferredSize: (106, 60), flex: 1);
                        }
                    }
                }
                Text("Select an argument to edit.", ref: ArgumentHelp, id: "designer-argument-help", wrapping: true);
                HStack(spacing: 6) {
                    Button("Apply property", ref: Apply, id: "designer-apply-property");
                    Button("Reset", ref: Reset, id: "designer-reset-property", enabled: false,
                        help: "Remove an authored named literal argument and use its default");
                }
                Text("Structure", fontSize: 18, fontWeight: 600);
                HStack(spacing: 6) {
                    Button("Move up", ref: Up, id: "designer-move-up", help: "Move to the previous sibling position (Alt+Up in hierarchy)");
                    Button("Move down", ref: Down, id: "designer-move-down", help: "Move to the next sibling position (Alt+Down in hierarchy)");
                }
                HStack(spacing: 6) {
                    Button("Duplicate", ref: Duplicate, id: "designer-duplicate", help: "Duplicate this control (Ctrl+D in hierarchy)");
                    Button("Delete", ref: Delete, id: "designer-delete", help: "Delete this control (Delete in hierarchy)");
                }
                Text("Select a control to change its structure.", ref: StructureHelp, id: "designer-structure-help", wrapping: true);
                Text("Wrap selected control");
                HStack(spacing: 6) {
                    Button("VStack", ref: WrapVertical, id: "designer-wrap-vertical", help: "Wrap in a vertical stack (Ctrl+G in hierarchy)");
                    Button("HStack", ref: WrapHorizontal, id: "designer-wrap-horizontal", help: "Wrap in a horizontal stack");
                    Button("Scroll", ref: WrapScroll, id: "designer-wrap-scroll", help: "Wrap in a scroll view");
                }
                Button("Unwrap one child", ref: Unwrap, id: "designer-unwrap", help: "Remove a safe one-child wrapper (Ctrl+Shift+G in hierarchy)");
                Text("Unwrap needs one child and refuses to discard wrapper properties, identities, or comments.", wrapping: true);
                Text("Control palette", fontSize: 18, fontWeight: 600);
                HStack(spacing: 6) {
                    TextInput("Find a control", ref: PaletteFilter, id: "designer-palette-filter", captionVisible: false,
                        placeholder: "Find: button, slider, layout", preferredSize: (190, 36), flex: 1);
                    Button("Clear control filter", ref: ClearPaletteFilter, id: "designer-palette-filter-clear",
                        icon: global::Xui.ButtonIcon.Close, size: (32, 32), help: "Show all controls");
                }
                Content(Palette, preferredSize: (240, 36));
                Text("", ref: PaletteHelp, id: "designer-palette-help", wrapping: true);
                Text("Insert control adds a child at the end. Insert before/after adds a sibling. Grid actions use the cell below.", wrapping: true);
                HStack(spacing: 6) {
                    TextInput("Grid row", ref: Row, id: "designer-grid-row", text: "0", preferredSize: (106, 60));
                    TextInput("Grid column", ref: Column, id: "designer-grid-column", text: "0", preferredSize: (106, 60));
                }
                Button("Find empty cell", ref: FindCell, id: "designer-find-grid-cell", enabled: false,
                    help: "Fill row and column from the selected Grid, or the parent Grid of a non-Grid selection");
                Button("Insert control", ref: Insert, id: "designer-insert-control");
                HStack(spacing: 6) {
                    Button("Insert before", ref: InsertBefore, id: "designer-insert-before",
                        help: "Insert the palette control before the selected sibling");
                    Button("Insert after", ref: InsertAfter, id: "designer-insert-after",
                        help: "Insert the palette control after the selected sibling");
                }
                Text("Ready", ref: Feedback, id: "designer-builder-feedback", wrapping: true);
            }
        }
    }
}

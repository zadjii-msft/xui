namespace Xui.Designer;

component DesignerSourceSearchLayout {
    param global::Xui.Element Editor;

    view {
        VStack(spacing: 6) {
            HStack(spacing: 4) {
                TextInput("Find in source", ref: Query, id: "designer-find-query", captionVisible: false,
                    placeholder: "Find (Ctrl+F)", preferredSize: (140, 32), flex: 1);
                Toggle("Aa", ref: MatchCase, id: "designer-find-case", help: "Match case");
                Button("Prev", ref: Previous, id: "designer-find-previous", enabled: false, help: "Previous match (Shift+F3)");
                Button("Next", ref: Next, id: "designer-find-next", enabled: false, help: "Next match (F3)");
            }
            Text("Find in source (Ctrl+F)", ref: Status, id: "designer-find-status", wrapping: true);
            Content(Editor, flex: 1);
        }
    }
}

namespace Xui.Designer;

component DesignerSourceSearchLayout {
    param global::Xui.Element Editor;
    state bool FindOpen = false;
    state bool ReplaceOpen = false;

    style FindPanel for Stack {
        padding: 8;
        spacing: 4;
        background: theme(light: 0xF3F4F6, dark: 0x292929);
    }

    view {
        Grid("Source editor and Find", rows: [new(global::Xui.TrackSizing.Fixed, FindOpen ? (ReplaceOpen ? 122 : 82) : 0), new(global::Xui.TrackSizing.Star)]) {
            VStack(style: FindPanel) {
                HStack(spacing: 4) {
                    TextInput("Find in source", ref: Query, id: "designer-find-query", captionVisible: false,
                        placeholder: "Find", preferredSize: (100, 32), flex: 1, visible: FindOpen);
                    Toggle("Aa", ref: MatchCase, id: "designer-find-case", help: "Match case", visible: FindOpen);
                    Toggle("Word", ref: WholeWord, id: "designer-find-word", help: "Match whole words", visible: FindOpen);
                    Button("Prev", ref: Previous, id: "designer-find-previous", enabled: false,
                        icon: global::Xui.ButtonIcon.ChevronUp, size: (32, 32), help: "Previous match (Shift+F3)", visible: FindOpen);
                    Button("Next", ref: Next, id: "designer-find-next", enabled: false,
                        icon: global::Xui.ButtonIcon.ChevronDown, size: (32, 32), help: "Next match (F3)", visible: FindOpen);
                    Button(ReplaceOpen ? "Hide replacement field" : "Show replacement field", ref: ReplaceToggle, id: "designer-find-replace-toggle",
                        icon: ReplaceOpen ? global::Xui.ButtonIcon.ChevronUp : global::Xui.ButtonIcon.ChevronDown,
                        size: (32, 32), help: "Toggle replacement field (Ctrl+H to open)", visible: FindOpen);
                    Button("Close find", ref: Close, id: "designer-find-close", icon: global::Xui.ButtonIcon.Close,
                        size: (32, 32), help: "Close find (Escape)", visible: FindOpen);
                }
                HStack(spacing: 4, preferredSize: (100, FindOpen && ReplaceOpen ? 36 : 0)) {
                    TextInput("Replace with", ref: Replacement, id: "designer-replace-text", captionVisible: false,
                        placeholder: "Replace with", preferredSize: (100, 32), flex: 1, visible: FindOpen && ReplaceOpen);
                    Button("Replace", ref: Replace, id: "designer-replace", enabled: false,
                        help: "Replace the selected match, then select the next match", visible: FindOpen && ReplaceOpen);
                    Button("Replace all", ref: ReplaceAll, id: "designer-replace-all", enabled: false,
                        help: "Replace all matches as one undo action", visible: FindOpen && ReplaceOpen);
                }
                Text("", ref: Status, id: "designer-find-status", visible: FindOpen);
            }
            Content(Editor, row: 1);
        }
    }
}

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <Import Project="..\Xui.Portable.targets" />
  <ItemGroup>
    <AdditionalFiles Include="..\SharedDemo\DynamicTaskBoard.xui;..\SharedDemo\TaskRow.xui" />
    <Compile Include="..\SharedDemo\DynamicTaskBoardModel.cs;..\SharedDemo\DynamicTaskBoardCodec.cs;..\SharedDemo\GalleryValues.cs;..\SharedDemo\ApplicationScenarioRunner.cs" />
    <None Include="..\SharedDemo\DynamicTaskScenarios.json" Link="DynamicTaskScenarios.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

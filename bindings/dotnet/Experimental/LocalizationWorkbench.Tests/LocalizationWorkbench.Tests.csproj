<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <Import Project="..\Xui.Portable.targets" />
  <Import Project="..\SharedDemo\Localization\LocalizationWorkbench.items.props" />
  <Target Name="ValidateLocalizationNegativeFixture" BeforeTargets="AssignTargetPaths">
    <Error Condition="'$(LocalizationTestOmitLanguage)' != '' and '$(LocalizationTestOmitLanguage)' != 'en' and '$(LocalizationTestOmitLanguage)' != 'de' and '$(LocalizationTestOmitLanguage)' != 'ar'"
        Text="LocalizationTestOmitLanguage must be empty, en, de, or ar." />
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)"
          Condition="'%(EmbeddedResource.LogicalName)' == 'PortableDemo.Localization.WorkbenchStrings.$(LocalizationTestOmitLanguage).resources'" />
    </ItemGroup>
  </Target>
</Project>

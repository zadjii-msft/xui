<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <Import Project="..\Xui.Portable.targets" />
  <ItemGroup>
    <AdditionalFiles Include="..\SharedDemo\ProfileWorkspace.xui;..\SharedDemo\ProfileEditPage.xui;..\SharedDemo\ProfilePreviewPage.xui" />
    <Compile Include="..\SharedDemo\ProfileWorkspaceModel.cs;..\SharedDemo\ProfileWorkspaceController.cs;..\SharedDemo\ProfileWorkspaceSession.cs;..\SharedDemo\ApplicationScenarioRunner.cs" />
    <None Include="..\SharedDemo\ProfileWorkspaceScenarios.json" Link="ProfileWorkspaceScenarios.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

{
  "version": 1,
  "scenarios": [
    {
      "name": "empty-order",
      "steps": [
        { "action": "click", "id": "reset" },
        { "action": "expect", "id": "customer-name", "text": "", "enabled": true, "visible": true },
        { "action": "expect", "id": "email", "text": "", "enabled": true, "visible": true },
        { "action": "expect", "id": "discount-code", "text": "", "enabled": true, "visible": true },
        { "action": "expect", "id": "coffee-quantity", "text": "Coffee: 0" },
        { "action": "expect", "id": "tea-quantity", "text": "Tea: 0" },
        { "action": "expect", "id": "cocoa-quantity", "text": "Cocoa: 0" },
        { "action": "expect", "id": "coffee-less", "enabled": false },
        { "action": "expect", "id": "tea-less", "enabled": false },
        { "action": "expect", "id": "cocoa-less", "enabled": false },
        { "action": "expect", "id": "coffee-more", "enabled": true },
        { "action": "expect", "id": "tea-more", "enabled": true },
        { "action": "expect", "id": "cocoa-more", "enabled": true },
        { "action": "expect", "id": "subtotal", "text": "Subtotal: $0.00" },
        { "action": "expect", "id": "discount-total", "text": "Discount: -$0.00" },
        { "action": "expect", "id": "total", "text": "Total: $0.00" },
        { "action": "expect", "id": "validation", "text": "Choose at least one item. Enter your name. Enter a valid email address.", "visible": true },
        { "action": "expect", "id": "review", "enabled": false },
        { "action": "expect", "id": "edit", "enabled": false },
        { "action": "expect", "id": "reset", "enabled": true },
        { "action": "expect", "id": "review-summary", "text": "", "visible": false },
        { "action": "click", "id": "review" },
        { "action": "click", "id": "edit" },
        { "action": "submit", "id": "customer-name" },
        { "action": "expect", "id": "review-summary", "text": "", "visible": false },
        { "action": "expect", "id": "total", "text": "Total: $0.00" }
      ]
    },
    {
      "name": "details-without-items",
      "steps": [
        { "action": "click", "id": "reset" },
        { "action": "change", "id": "customer-name", "value": "Ada" },
        { "action": "change", "id": "email", "value": "ada@example.test" },
        { "action": "change", "id": "discount-code", "value": "SAVE10" },
        { "action": "expect", "id": "validation", "text": "Choose at least one item." },

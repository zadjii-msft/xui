        { "action": "click", "id": "tea-more" },
        { "action": "expect", "id": "total", "text": "Total: $7.20" },
        { "action": "expect", "id": "review", "enabled": true },
        { "action": "click", "id": "tea-less" },
        { "action": "expect", "id": "tea-quantity", "text": "Tea: 0" },
        { "action": "expect", "id": "total", "text": "Total: $0.00" },
        { "action": "expect", "id": "review", "enabled": false }
      ]
    },
    {

{
  "version": 1,
  "scenarios": [
    {
      "name": "binary-and-mixed-choices",
      "steps": [
        { "action": "click", "id": "reset-settings" },
        { "action": "expect", "id": "notifications", "checked": true, "enabled": true },
        { "action": "expect", "id": "sync-policy", "checkState": "Indeterminate", "enabled": true },
        { "action": "expect", "id": "cycle-mixed", "checked": true },
        { "action": "expect", "id": "changes-summary", "text": "Changes: 0" },
        { "action": "change", "id": "settings-draft", "value": "Retained \u674e text" },
        { "action": "click", "id": "notifications" },
        { "action": "expect", "id": "notifications", "checked": false },
        { "action": "expect", "id": "notifications-summary", "text": "Notifications: off" },
        { "action": "click", "id": "sync-policy" },
        { "action": "expect", "id": "sync-policy", "checkState": "Unchecked" },
        { "action": "click", "id": "sync-policy" },
        { "action": "expect", "id": "sync-policy", "checkState": "Checked" },
        { "action": "click", "id": "sync-policy" },
        { "action": "expect", "id": "sync-policy", "checkState": "Indeterminate" },
        { "action": "click", "id": "cycle-mixed" },
        { "action": "expect", "id": "cycle-mixed", "checked": false },
        { "action": "expect", "id": "sync-policy", "checkState": "Indeterminate" },
        { "action": "click", "id": "sync-policy" },
        { "action": "expect", "id": "sync-policy", "checkState": "Unchecked" },
        { "action": "click", "id": "sync-policy" },
        { "action": "expect", "id": "sync-policy", "checkState": "Checked" },
        { "action": "click", "id": "sync-policy" },
        { "action": "expect", "id": "sync-policy", "checkState": "Unchecked" },
        { "action": "expect", "id": "changes-summary", "text": "Changes: 8" },
        { "action": "expect", "id": "settings-draft", "text": "Retained \u674e text" },
        { "action": "click", "id": "reset-settings" },
        { "action": "expect", "id": "notifications", "checked": true },
        { "action": "expect", "id": "sync-policy", "checkState": "Indeterminate" },
        { "action": "expect", "id": "cycle-mixed", "checked": true },
        { "action": "expect", "id": "settings-draft", "text": "" },
        { "action": "expect", "id": "changes-summary", "text": "Changes: 0" }
      ]
    },
    {
      "name": "disabled-choice-boundaries",
      "steps": [
        { "action": "click", "id": "reset-settings" },
        { "action": "click", "id": "options-enabled" },
        { "action": "expect", "id": "options-enabled", "checked": false, "enabled": true },
        { "action": "expect", "id": "notifications", "checked": true, "enabled": false },
        { "action": "expect", "id": "sync-policy", "checkState": "Indeterminate", "enabled": false },
        { "action": "expect", "id": "cycle-mixed", "enabled": false },
        { "action": "expect", "id": "indeterminate", "enabled": false },
        { "action": "expect", "id": "work-progress", "enabled": false },
        { "action": "expect", "id": "advance-progress", "enabled": false },
        { "action": "click", "id": "notifications" },
        { "action": "click", "id": "sync-policy" },
        { "action": "click", "id": "advance-progress" },
        { "action": "expect", "id": "notifications", "checked": true },
        { "action": "expect", "id": "sync-policy", "checkState": "Indeterminate" },
        { "action": "expect", "id": "changes-summary", "text": "Changes: 1" },
        { "action": "expect", "id": "work-progress", "minimum": 0, "maximum": 100, "value": 25, "indeterminate": false },
        { "action": "click", "id": "options-enabled" },
        { "action": "expect", "id": "notifications", "enabled": true },
        { "action": "expect", "id": "sync-policy", "enabled": true },
        { "action": "expect", "id": "work-progress", "enabled": true },
        { "action": "expect", "id": "changes-summary", "text": "Changes: 2" }
      ]
    },
    {
      "name": "read-only-progress-and-reset",
      "steps": [
        { "action": "click", "id": "reset-settings" },
        { "action": "expect", "id": "work-progress", "minimum": 0, "maximum": 100, "value": 25, "indeterminate": false, "visible": true },
        { "action": "expect", "id": "unit-progress", "minimum": -10, "maximum": 30, "value": 2.5, "indeterminate": false },
        { "action": "click", "id": "advance-units" },
        { "action": "expect", "id": "unit-progress", "minimum": -10, "maximum": 30, "value": 2.75 },
        { "action": "expect", "id": "units-summary", "text": "Units: 2.75" },
        { "action": "expect", "id": "progress-summary", "text": "Progress: 25.00 / 100.00" },
        { "action": "click", "id": "advance-progress" },
        { "action": "expect", "id": "work-progress", "value": 50 },
        { "action": "click", "id": "advance-progress" },
        { "action": "expect", "id": "work-progress", "value": 75 },
        { "action": "click", "id": "advance-progress" },
        { "action": "expect", "id": "work-progress", "value": 100 },
        { "action": "expect", "id": "advance-progress", "enabled": false },
        { "action": "click", "id": "advance-progress" },
        { "action": "expect", "id": "progress-summary", "text": "Progress: 100.00 / 100.00" },
        { "action": "click", "id": "indeterminate" },
        { "action": "expect", "id": "indeterminate", "checked": true },
        { "action": "expect", "id": "work-progress", "value": null, "indeterminate": true },
        { "action": "click", "id": "indeterminate" },
        { "action": "expect", "id": "work-progress", "value": 100, "indeterminate": false },
        { "action": "expect", "id": "changes-summary", "text": "Changes: 2" },
        { "action": "click", "id": "reset-settings" },
        { "action": "expect", "id": "work-progress", "value": 25, "indeterminate": false },
        { "action": "expect", "id": "unit-progress", "value": 2.5, "indeterminate": false },
        { "action": "expect", "id": "advance-progress", "enabled": true },
        { "action": "expect", "id": "changes-summary", "text": "Changes: 0" }
      ]
    }
  ]
}

namespace PortableDemo;

component StudioSectionPanel {
    param string Heading;
    param string Description;
    view {
        VStack(spacing: 4, padding: 8) {
            Text(Heading, textRole: global::Xui.Experimental.Portable.TextRole.Title,
                textLayout: global::Xui.Experimental.Portable.LabelTextLayout.Wrap(2));
            Text(Description, textRole: global::Xui.Experimental.Portable.TextRole.Caption,
                textLayout: global::Xui.Experimental.Portable.LabelTextLayout.Wrap(2));
        }
    }
}

        { "action": "expect", "id": "studio-catalog-count", "text": "1 matching documents" },
        { "action": "openDocument", "key": "doc-09999" },
        { "action": "expectTabs", "count": 3, "selected": 9999 },
        { "action": "expect", "id": "doc-09999-title", "text": "Performance review 09999" },
        { "action": "change", "id": "doc-09999-title", "value": "" },
        { "action": "expect", "id": "doc-09999-validation", "text": "Enter a document title." },
        { "action": "expect", "id": "doc-09999-analyze", "enabled": false },
        { "action": "closeTab", "id": 1 },
        { "action": "closeTab", "id": 2 },
        { "action": "closeTab", "id": 9999 },
        { "action": "expectTabs", "count": 0, "selected": null },
        { "action": "expect", "id": "studio-empty", "text": "No open documents. Select Library to open a document." },
        { "action": "selectSection", "id": 2 },
        { "action": "expect", "id": "studio-catalog-count", "text": "1 matching documents" },
        { "action": "openDocument", "key": "doc-09999" },
        { "action": "expectTabs", "count": 1, "selected": 9999 },
        { "action": "expect", "id": "doc-09999-title", "text": "" },
        { "action": "click", "id": "doc-09999-revert" },
        { "action": "expect", "id": "doc-09999-title", "text": "Performance review 09999" },
        { "action": "expect", "id": "studio-catalog-count", "text": "0 matching documents" }
      ]
    },
    {
      "name": "operations-dashboard-to-editor-workflow",

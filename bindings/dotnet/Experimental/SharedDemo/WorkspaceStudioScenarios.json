        { "action": "expect", "id": "operations-documents", "text": "Documents: 2" },
        { "action": "expect", "id": "operations-drafts", "text": "Drafts: 2" },
        { "action": "expect", "id": "operations-open", "text": "Open documents: 2" },
        { "action": "expect", "id": "operations-words", "text": "Words: 11" },
        { "action": "expect", "id": "operations-characters", "text": "Characters: 46" },
        { "action": "expect", "id": "operations-tasks", "text": "Checklist items: 3" },
        { "action": "expect", "id": "operations-engineering", "text": "Engineering: 1" },
        { "action": "expect", "id": "operations-design", "text": "Design: 1" },
        { "action": "expect", "id": "operations-research", "text": "Research: 0" },
        { "action": "expect", "id": "operations-freshness", "text": "CURRENT LOCAL SNAPSHOT" },
        { "action": "click", "id": "operations-doc-00001-open" },
        { "action": "expectTabs", "count": 3, "selected": 1 },
        { "action": "expect", "id": "doc-00001-body", "text": "One two\n- three four\n\n- five" },
        { "action": "change", "id": "doc-00001-body", "value": "Changed after snapshot" },
        { "action": "selectTab", "id": 10001 },
        { "action": "expect", "id": "operations-freshness", "text": "STALE SNAPSHOT / REFRESH REQUIRED" },
        { "action": "expect", "id": "operations-words", "text": "Words: 11" },
        { "action": "click", "id": "operations-browse-design" },
        { "action": "expect", "id": "studio-catalog-count", "text": "3333 matching documents" },
        { "action": "closeTab", "id": 10001 },
        { "action": "expectTabs", "count": 2, "selected": 2 },
        { "action": "expect", "id": "doc-00002-body", "text": "Alpha beta\n- gamma" }
      ]
    },
    {
      "name": "shared-back-section-policy",
      "steps": [
        { "action": "selectSection", "id": 2 },
        { "action": "expect", "id": "studio-catalog-count", "text": "0 matching documents" },
        { "action": "back", "handled": true, "blocked": false },
        { "action": "expect", "id": "studio-catalog-count", "text": "10000 matching documents" },
        { "action": "back", "handled": false, "blocked": false },
        { "action": "expectTabs", "count": 2, "selected": 1 },
        { "action": "selectSection", "id": 3 },
        { "action": "back", "handled": true, "blocked": false },
        { "action": "back", "handled": false, "blocked": false },
        { "action": "expectTabs", "count": 2, "selected": 1 }
      ]
    },
    {
      "name": "workspace-screenshot-state",
      "steps": [
        { "action": "change", "id": "doc-00001-title", "value": "Workspace delivery plan" },
        { "action": "change", "id": "doc-00001-body", "value": "Workspace delivery plan\n\nGoals\n- Retain document editors across tab switches.\n- Keep the catalog virtualized and accessible.\n- Adapt the same workspace to desktop and phone.\n\nAll work stays in this local draft." },
        { "action": "click", "id": "doc-00001-analyze" },
        { "action": "awaitAnalysis" },
        { "action": "expectTabs", "count": 2, "selected": 1 },
        { "action": "expect", "id": "doc-00001-title", "text": "Workspace delivery plan" },
        { "action": "expect", "id": "studio-summary", "text": "2 open / 1 local drafts" },
        { "action": "expect", "id": "studio-status", "text": "Analysis complete. No content left this workspace." }
      ]

        { "action": "selectTab", "id": 2 },
        { "action": "change", "id": "doc-00002-body", "value": "Alpha beta\n- gamma" },
        { "action": "click", "id": "studio-open-operations" },
        { "action": "expectTabs", "count": 3, "selected": 10001 },

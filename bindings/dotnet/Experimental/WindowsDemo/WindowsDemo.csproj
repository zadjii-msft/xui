<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(XuiRuntimeIdentifier)</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <XuiHotReload>false</XuiHotReload>
  </PropertyGroup>
  <Import Project="..\..\Xui.Declarative.targets" />
  <ItemGroup>
    <AdditionalFiles Include="..\SharedDemo\Greeting.xui" Link="Greeting.xui" />
  </ItemGroup>
</Project>

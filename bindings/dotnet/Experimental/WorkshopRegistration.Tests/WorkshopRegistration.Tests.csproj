    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <Import Project="..\Xui.Portable.targets" />
  <ItemGroup>
    <AdditionalFiles Include="..\SharedDemo\WorkshopRegistration.xui" />
    <Compile Include="..\SharedDemo\WorkshopRegistrationModel.cs;..\SharedDemo\WorkshopScenarioRunner.cs;..\SharedDemo\GalleryValues.cs;..\SharedDemo\OrderModel.cs" />
    <None Include="..\SharedDemo\WorkshopScenarios.json" Link="WorkshopScenarios.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

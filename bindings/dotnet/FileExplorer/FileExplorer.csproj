<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>..\..\..\demo\xui.manifest</ApplicationManifest>
    <XuiHotReload>false</XuiHotReload>
  </PropertyGroup>
  <Import Project="..\Xui.Declarative.targets" />
  <Target Name="CopyXuiRuntime" AfterTargets="Build" Condition="'$(XuiNativeDir)' != ''">
    <Copy SourceFiles="$(XuiNativeDir)\xui.dll" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>

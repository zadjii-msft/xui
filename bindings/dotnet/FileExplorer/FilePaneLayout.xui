namespace Xui.FileExplorer;

component FilePaneLayout {
    param int Number;
    param global::Xui.Element AddressBar;
    state bool FindOpen = false;
    state bool ToolbarOpen = true;

    view {
        Grid($"Pane {Number} layout",
            rows: [new(global::Xui.TrackSizing.Automatic), new(global::Xui.TrackSizing.Star),
                new(global::Xui.TrackSizing.Automatic), new(global::Xui.TrackSizing.Automatic)]) {
            Reveal("Toolbar", open: ToolbarOpen, duration: 0, layout: global::Xui.RevealLayout.Expand) {
                HStack(spacing: 4, padding: 8, ref: Toolbar) {
                    Button("Back", ref: Back, id: $"pane-{Number}-back", icon: global::Xui.ButtonIcon.Back, size: (36, 36));
                    Button("Forward", ref: Forward, id: $"pane-{Number}-forward", icon: global::Xui.ButtonIcon.Forward, size: (36, 36));
                    Button("Up", ref: Up, id: $"pane-{Number}-up", icon: global::Xui.ButtonIcon.Up, size: (36, 36));
                    Content(AddressBar, flex: 1);
                    Button("Refresh", ref: Refresh, id: $"pane-{Number}-refresh", icon: global::Xui.ButtonIcon.Refresh, size: (36, 36));
                    Button("Commands", ref: Commands, id: $"pane-{Number}-commands", icon: global::Xui.ButtonIcon.More, size: (36, 36), help: "Commands (Ctrl+Shift+P)");
                }
            }
            Grid($"File views in pane {Number}", ref: ContentHost, row: 1) {
                DataGrid($"Files in pane {Number}", ref: Files, id: $"pane-{Number}-files",
                    columns: FileRows.Columns);
            }
            Reveal("Find", open: FindOpen, duration: 180, layout: global::Xui.RevealLayout.Expand, ref: FindReveal, row: 2) {
                HStack(ref: FindHost, padding: 6, spacing: 8) {
                    TextInput("Find", ref: Find, id: $"pane-{Number}-find", captionVisible: false,
                        placeholder: "Find", preferredSize: (320, 44), flex: 1);
                    Button("Close find", ref: CloseFind, id: $"pane-{Number}-close-find", icon: global::Xui.ButtonIcon.Close,
                        size: (44, 44), help: "Close find (Escape)");
                }
            }
            HStack(padding: 6, spacing: 8, ref: Footer, row: 3) {
                Text("", ref: Feedback, id: $"pane-{Number}-feedback", flex: 1);
                Text("Loading folder...", ref: Status, id: $"pane-{Number}-status");
                Button("Choose view", ref: ViewMode, id: $"pane-{Number}-view-mode",
                    icon: global::Xui.ButtonIcon.Library, size: (32, 32), help: "Choose icons, List, Tree, Details, or Columns");
                Button("Folders, then files", ref: Partition, id: $"pane-{Number}-partition",
                    icon: global::Xui.ButtonIcon.FoldersFirst, size: (32, 32), help: "Choose folder and file order");
            }
        }
    }
}

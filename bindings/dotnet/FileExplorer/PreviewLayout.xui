namespace Xui.FileExplorer;

component PreviewLayout {
    param global::Xui.Element Body;
    param global::Xui.Element Status;
    param global::Xui.Element ProviderStatus;

    view {
        VStack(padding: 12, spacing: 8) {
                Content(Body, flex: 1);
                HStack(spacing: 12) {
                    Button("Open Windows preview", ref: WindowsPreview, id: "preview-windows",
                        size: (190, 36), help: "Open an installed handler in a separate window. This is not a network or macro sandbox.");
                    Text("Separate window. Not a sandbox.\nHandlers can access files and the network.", flex: 1);
                }
                Content(ProviderStatus);
                Content(Status);
        }
    }
}

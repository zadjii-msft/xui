namespace Xui.FileExplorer;

component PreviewMetadataLayout {
    param global::Xui.Element Icon;
    param global::Xui.FileExplorer.Models.FileEntry Target;
    state bool MetadataVisible = false;

    style Heading for Label {
        fontSize: 28;
        fontWeight: 600;
    }

    style Detail for Label {
        fontSize: 13;
    }

    view {
        Grid("File information",
            rows: [new(global::Xui.TrackSizing.Star), new(global::Xui.TrackSizing.Automatic),
                new(global::Xui.TrackSizing.Star)],
            columns: [new(global::Xui.TrackSizing.Fixed, 12), new(global::Xui.TrackSizing.Fixed, 160),
                new(global::Xui.TrackSizing.Fixed, 32), new(global::Xui.TrackSizing.Star),
                new(global::Xui.TrackSizing.Fixed, 12)]) {
            Content(Icon, preferredSize: (160, 160), row: 1, column: 1);
            VStack(spacing: 6, row: 1, column: 3) {
                Text(Target.Name, ref: Name, id: "preview-file-name", style: Heading, visible: MetadataVisible);
                Text($"File Type: {(Target.IsDirectory ? "File folder" : Target.Kind)}",
                    ref: Kind, id: "preview-file-kind", style: Detail, visible: MetadataVisible);
                Text(Target.IsDirectory ? "Size: Not calculated"
                    : $"Size: {FileRows.FormatSize(Target.Size)} ({Target.Size:N0} bytes)",
                    ref: Size, id: "preview-file-size", style: Detail, visible: MetadataVisible);
                Text($"Date Modified: {Target.ModifiedUtc.ToLocalTime():g}",
                    ref: Modified, id: "preview-file-modified", style: Detail, visible: MetadataVisible);
            }
        }
    }
}

namespace Xui.FileExplorer;

component SidebarLayout {
    state bool NavigationOpen = true;
    view {
        Reveal("Navigation pane", open: NavigationOpen, duration: 180,
            layout: global::Xui.RevealLayout.Expand, direction: global::Xui.RevealDirection.Left) {
            NavigationView("Explorer navigation", ref: Navigation, id: "explorer-navigation", headerVisible: false, duration: 180,
                searchId: "navigation-filter", searchHelp: "Filter navigation (Alt+F)");
        }
    }
}

    code csharp {
        public void NewGame() { Game = GameState.New(); Flagging = false; }
        public void ToggleFlagMode() => Flagging = !Flagging;
        void SetFlagMode(bool value) => Flagging = value;
        void Activate(int index) => Game = Flagging ? Game.Flag(index) : Game.Reveal(index);

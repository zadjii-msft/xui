# Keep the checker on evaluated CMake facts, not a second hand-maintained source list.
function(xui_architecture_array output)
    set(result "[]")
    set(index 0)
    foreach(value IN LISTS ARGN)
        string(REPLACE "\\" "/" value "${value}")
        string(REPLACE "\"" "\\\"" value "${value}")
        string(JSON result SET "${result}" ${index} "\"${value}\"")
        math(EXPR index "${index} + 1")
    endforeach()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(xui_enforce_architecture)
    set(xui_architecture_targets "{}")
    foreach(target xui_core xui_file_list xui_windows xui)
        if(NOT TARGET ${target})
            continue()
        endif()
        get_target_property(sources ${target} SOURCES)
        get_target_property(links ${target} LINK_LIBRARIES)
        get_target_property(interface_links ${target} INTERFACE_LINK_LIBRARIES)
        if(NOT links)
            set(links "")
        endif()
        if(interface_links)
            list(APPEND links ${interface_links})
        endif()
        set(normalized_links "")
        foreach(link IN LISTS links)
            string(REGEX REPLACE "^\\$<LINK_ONLY:([^<>]+)>$" "\\1" link "${link}")
            list(APPEND normalized_links "${link}")
        endforeach()
        set(links ${normalized_links})
        list(REMOVE_DUPLICATES links)
        if(target STREQUAL "xui_core")
            foreach(link IN LISTS links)
                if(NOT link STREQUAL "Threads::Threads")
                    message(FATAL_ERROR "Architecture: xui_core cannot link ${link}")
                endif()
            endforeach()
        elseif(target STREQUAL "xui_file_list")
            foreach(link IN LISTS links)
                if(NOT link MATCHES "^(xui_core|Threads::Threads)$")
                    message(FATAL_ERROR "Architecture: xui_file_list cannot link ${link}")
                endif()
            endforeach()
        elseif(target STREQUAL "xui" AND NOT links STREQUAL "xui_windows")
            message(FATAL_ERROR "Architecture: the ABI target must link only xui_windows")
        endif()
        xui_architecture_array(source_json ${sources})
        xui_architecture_array(link_json ${links})
        string(JSON entry SET "{}" sources "${source_json}")
        string(JSON entry SET "${entry}" links "${link_json}")
        string(JSON xui_architecture_targets SET "${xui_architecture_targets}" ${target} "${entry}")
    endforeach()
    set(xui_architecture_manifest "${CMAKE_CURRENT_BINARY_DIR}/architecture-targets.json")
    file(WRITE "${xui_architecture_manifest}" "${xui_architecture_targets}\n")

    if(BUILD_TESTING)
        find_package(Python3 COMPONENTS Interpreter REQUIRED)
        set(xui_architecture_command "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/architecture.py"
            --root "${PROJECT_SOURCE_DIR}" --targets "${xui_architecture_manifest}"
            --report "${CMAKE_CURRENT_BINARY_DIR}/architecture-report.json")
        execute_process(COMMAND ${xui_architecture_command} RESULT_VARIABLE boundary_status)
        if(NOT boundary_status EQUAL 0)
            message(FATAL_ERROR "XUI architecture boundary check failed (${boundary_status})")
        endif()
        add_custom_target(xui_architecture_check COMMAND ${xui_architecture_command} VERBATIM)
        foreach(target xui_core xui_file_list xui_windows xui)
            if(TARGET ${target})
                add_dependencies(${target} xui_architecture_check)
            endif()
        endforeach()
        add_test(NAME xui_architecture_tests COMMAND ${xui_architecture_command})
        add_test(NAME xui_architecture_negative_tests COMMAND "${Python3_EXECUTABLE}"
            -m unittest discover -s "${PROJECT_SOURCE_DIR}/tests" -p test_architecture.py)
        add_test(NAME xui_architecture_cmake_tests COMMAND "${Python3_EXECUTABLE}"
            "${PROJECT_SOURCE_DIR}/tests/architecture-cmake.py" --cmake "${CMAKE_COMMAND}"
            --generator "${CMAKE_GENERATOR}" "--platform=${CMAKE_GENERATOR_PLATFORM}"
            --report "${CMAKE_CURRENT_BINARY_DIR}/architecture-negative.json")
        set_tests_properties(xui_architecture_tests xui_architecture_negative_tests xui_architecture_cmake_tests
            PROPERTIES TIMEOUT 120 LABELS "headless;architecture")
    endif()
endfunction()

cmake_language(DEFER CALL xui_enforce_architecture)

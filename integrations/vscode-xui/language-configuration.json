{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^((?!//).)*[\\{\\(\\[]\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*[\\}\\)\\]]"
  },
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*(?://\\s*|#)region\\b",
      "end": "^\\s*(?://\\s*|#)endregion\\b"
    }
  }
}

{
  "Component": {
    "prefix": "component",
    "body": [
      "component ${1:Counter} {",
      "\tstate int ${2:Count} = 0;",
      "\tview {",
      "\t\tVStack(spacing: 8, padding: 16) {",
      "\t\t\tText(\\$\"${2:Count}: {${2:Count}}\", id: \"count\");",
      "\t\t\tButton(\"Increment\", click: ${3:Increment}, id: \"increment\");",
      "\t\t}",
      "\t}",
      "\tcode csharp {",
      "\t\tvoid ${3:Increment}() => ${2:Count}++;",
      "\t}",
      "}",
      "$0"
    ],
    "description": "Counter component with state, a view, and a C# handler"
  },
  "Namespace": {
    "prefix": "namespace",
    "body": ["namespace ${1:Demo};", "$0"],
    "description": "Optional namespace declaration"
  },
  "State": {
    "prefix": "state",
    "body": "state ${1:int} ${2:Count} = ${3:0};",
    "description": "Component state with a C# initializer"
  },
  "Color resources": {
    "prefix": "resources",
    "body": [
      "resources {",
      "\t${1:DangerFill}: theme(light: ${2:0xB42318}, dark: ${3:0x8F1D16});",
      "\t$0",
      "}"
    ],
    "description": "Component color resources with light and dark values"
  },
  "Button style": {
    "prefix": "style",
    "body": [
      "style ${1:DangerButton} for Button {",
      "\tbackground: resource(${2:DangerFill});",
      "\tcornerRadius: 0;",
      "\tborderThickness: (3, 0, 0, 0);",
      "\t$0",
      "}"
    ],
    "description": "Named sparse Button style"
  },
  "Style state": {
    "prefix": "when",
    "body": ["when ${1:hovered} {", "\tbackground: resource(${2:DangerHover});", "\t$0", "}"],
    "description": "Style state override on a part that supports background"
  },
  "Derived Button style": {
    "prefix": "stylebasedon",
    "body": [
      "style ${1:CompactDanger} for Button basedOn ${2:DangerButton} {",
      "\tpadding: (8, 2, 8, 2);",
      "\t$0",
      "}"
    ],
    "description": "Sparse Button style derived from a declared base style"
  },
  "Styled Button": {
    "prefix": "styledbutton",
    "body": "Button(\"${1:Delete}\", style: ${2:DangerButton});",
    "description": "Button with a declared named style"
  },
  "Toggle style": {
    "prefix": "togglestyle",
    "body": [
      "style ${1:CompactToggle} for Toggle {",
      "\tforeground: theme(light: 0x202020, dark: 0xEEEEEE);",
      "\tpart indicator {",
      "\t\tbackground: theme(light: 0xEEEEEE, dark: 0x202020);",
      "\t\tborderBrush: 0x777777;",
      "\t\tborderThickness: 1;",
      "\t\tcornerRadius: 3;",
      "\t\tsize: 18;",
      "\t\twhen checked { background: 0x2468AD; }",
      "\t}",
      "\tpart mark { foreground: 0xFFFFFF; }",
      "\twhen disabled { foreground: 0x888888; }",
      "\t$0",
      "}"
    ],
    "description": "Toggle style with an indicator, check mark, and state overrides"
  },
  "Styled Toggle": {
    "prefix": "styledtoggle",
    "body": "Toggle(\"${1:Active}\", style: ${2:CompactToggle});",
    "description": "Toggle with a declared named style"
  },
  "Control style": {
    "prefix": "controlstyle",
    "body": [
      "style ${1:Heading} for ${2:Label} {",
      "\tforeground: ${3:0x202020};",
      "\t$0",
      "}"
    ],
    "description": "Named style for a supported catalog target"
  },
  "Style part": {
    "prefix": "part",
    "body": ["part ${1:label} {", "\tforeground: ${2:0x202020};", "\t$0", "}"],
    "description": "Direct style part with a supported foreground property"
  },
  "Typography style": {
    "prefix": "typographystyle",
    "body": [
      "style ${1:Heading} for Label {",
      "\tfontFamily: \"Segoe UI\";",
      "\tfontSize: 20;",
      "\tfontWeight: 600;",
      "\tfontStyle: normal;",
      "\thorizontalAlignment: start;",
      "\twrapping: true;",
      "\tmaximumLines: 2;",
      "\t$0",
      "}"
    ],
    "description": "Label typography style, applicable with Text or Content"
  },
  "Styled content": {
    "prefix": "styledcontent",
    "body": "Content(${1:ExistingElement}, style: ${2:Heading});",
    "description": "Apply a named generic style to an existing element of the matching target"
  },
  "View": {
    "prefix": "view",
    "body": ["view {", "\t$0", "}"],
    "description": "Component view block"
  },
  "C# code": {
    "prefix": "code",
    "body": ["code csharp {", "\t$0", "}"],
    "description": "C# members and handlers"
  },
  "Vertical stack": {
    "prefix": "vstack",
    "body": ["VStack(spacing: ${1:8}, padding: ${2:16}) {", "\t$0", "}"],
    "description": "Vertical layout"
  },
  "Horizontal stack": {
    "prefix": "hstack",
    "body": ["HStack(spacing: ${1:8}, padding: ${2:16}) {", "\t$0", "}"],
    "description": "Horizontal layout"
  },
  "Text": {
    "prefix": "text",
    "body": "Text(${1:\"Hello\"}, id: \"${2:label}\");",
    "description": "Text label"
  },
  "Button": {
    "prefix": "button",
    "body": "Button(\"${1:Increment}\", click: ${2:Increment}, id: \"${3:increment}\");",
    "description": "Button with a named method handler"
  },
  "Toggle": {
    "prefix": "toggle",
    "body": "Toggle(\"${1:Enabled}\", checked: ${2:IsEnabled}, change: ${3:OnChanged}, id: \"${4:enabled}\");",
    "description": "Toggle with state and a named change handler"
  },
  "Text input": {
    "prefix": "textinput",
    "body": "TextInput(text: ${1:Input}, change: ${2:OnChanged}, submit: ${3:OnSubmit}, id: \"${4:input}\");",
    "description": "Text input with named change and submit handlers"
  }
}

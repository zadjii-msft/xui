namespace Demo.Nested;
component Nested {
  state int Count = Math.Max(0, new[] { 1, 2 }[0]);
  state string Caption = @"brace } and ""quote""";
  code csharp {
    void Increment() {
      if (Count > 0) {
        var ignored = "} // not a comment";
        var verbatim = @"first } line
second ""quoted"" } line";
        var interpolated = $"outer {Math.Max(Count, 1)} {{escaped}}";
        // } } Text("not XUI");
        /* }
           } view { */
        Count++;
      }
      Count += 2;
    }
  }
  view {
    VStack(spacing: 8, padding: 16) {
      HStack(spacing: 4) {
        Text($"Count: {Math.Max(Count, 1)}", id: "nested");
        Button("Go", click: Increment, enabled: true, id: "go-button");
        Toggle("Enabled", checked: IsEnabled, change: OnChanged);
        TextInput(text: Input, change: OnChanged, submit: OnSubmit);
      }
      Text("Recovered", id: "after-code");
    }
  }
}
component Second {
  view {
    Text("Second component");
  }
}

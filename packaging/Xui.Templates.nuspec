<?xml version="1.0"?>
<package>
  <metadata>
    <id>Xui.Templates</id>
    <version>$version$</version>
    <authors>zadjii-msft</authors>
    <license type="expression">MIT</license>
    <description>Project templates for XUI Windows desktop applications with C# and declarative .xui controls.</description>
    <projectUrl>https://github.com/zadjii-msft/xui</projectUrl>
    <repository type="git" url="https://github.com/zadjii-msft/xui" />
    <readme>README.md</readme>
    <icon>zoey-256.png</icon>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
  </metadata>
  <files>
    <file src="LICENSE" target="LICENSE" />
    <file src="packaging\TEMPLATES.md" target="README.md" />
    <file src="assets\branding\generated\zoey-256.png" target="" />
    <file src="$templateRoot$\XuiApp.csproj" target="templates\xui" />
    <file src="templates\xui\Program.cs" target="templates\xui" />
    <file src="templates\xui\Counter.xui" target="templates\xui" />
    <file src="templates\xui\.template.config\template.json" target="templates\xui\.template.config" />
  </files>
</package>
